# Optional Telegram integration. Leave all four credential fields blank to keep the bot disabled.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
# Default: bot is connected for commands/manual pull only. It will not push alerts.
TELEGRAM_MANUAL_PULL_ONLY=true
TELEGRAM_AUTO_ALERTS_ENABLED=false
TELEGRAM_ADMIN_IDS=
TELEGRAM_BOT_SESSION_NAME=bot_alert_session
TELEGRAM_USER_SESSION_NAME=user_scraper_session
DASHBOARD_URL=http://YOUR_SERVER_IP:8501
DASHBOARD_LOCK_ENABLED=true
APP_ENV=production
UI_THEME=dark

TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
# Rotate the isolated SOCKS identity every 15 minutes when Tor uses IsolateSOCKSAuth.
TOR_SOCKS_ISOLATION=true
TOR_SOCKS_IDENTITY_INTERVAL_SECONDS=900
# Optional gentle circuit renewal. Requires Tor ControlPort/CookieAuthentication or a password.
TOR_NEWNYM_ENABLED=false
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=
TOR_NEWNYM_INTERVAL_SECONDS=900
# 0 keeps renewal time-based. Use a large number only when a request-count fallback is wanted.
TOR_NEWNYM_EVERY_REQUESTS=0
TOR_NEWNYM_MIN_INTERVAL_SECONDS=600
# Optional fail-closed checks. Leave false until `--opsec-audit` passes on the server.
OPSEC_STRICT_MODE=false
OPSEC_REQUIRE_TOR_ISOLATION=false
OPSEC_PURGE_ON_START=false

# Generated-artifact retention. Reports are retained unless explicitly enabled below.
PREVIEW_RETENTION_DAYS=7
SCREENSHOT_RETENTION_DAYS=7
LOG_RETENTION_DAYS=14
PURGE_GENERATED_REPORTS=false
REPORT_RETENTION_DAYS=30

# Strict operational observability. Events contain only fixed-schema counters,
# reason codes, timing, queue sizes, and install-local HMAC references.
OPS_LOG_MAX_BYTES=10485760
OPS_LOG_BACKUP_COUNT=5
OPS_LOG_TOTAL_MAX_BYTES=536870912
OPS_QUEUE_SAMPLE_SECONDS=60
OPS_DB_SLOW_MS=250
OPS_LOG_RETENTION_DAYS=14
OPS_SUMMARY_RETENTION_DAYS=30
OPS_DIAGNOSTIC_RETENTION_COUNT=10
# Hard work bounds for sanitized bundle generation (after gzip decompression).
OPS_DIAGNOSTIC_MAX_EVENTS=2500
OPS_DIAGNOSTIC_SCAN_MAX_BYTES=67108864
# Maximum sanitized diagnostic ZIP size the admin-only Telegram action may send.
TELEGRAM_DIAGNOSTIC_MAX_BYTES=10485760

# Storage minimization defaults. Full HTML/body persistence remains disabled.
STORE_RAW_HTML=false
STORE_FULL_VISIBLE_TEXT=false
STORE_SAFE_SNIPPETS=true
MAX_SAFE_SNIPPET_CHARS=500

ALLOW_CLEARNET_FETCH=false
# Exact public-provider lookups are doubly opt-in: both flags above/below must
# be true. Requests remain GET-only, redirect-free, byte-capped and routed
# through the configured Tor socks5h proxy. They never change live decisions.
DEEP_DISCOVERY_WORKER_ENABLED=true
DEEP_DISCOVERY_AUTO_ENABLED=true
DEEP_DISCOVERY_AUTO_THRESHOLD=0.90
DEEP_DISCOVERY_NETWORK_ENABLED=false
DEEP_DISCOVERY_OPENPGP_ENABLED=true
DEEP_DISCOVERY_RDAP_ENABLED=true
DEEP_DISCOVERY_CT_ENABLED=true
DEEP_DISCOVERY_MAX_PROVIDER_REQUESTS_PER_JOB=5
DEEP_DISCOVERY_DELAY_SECONDS=10
DEEP_DISCOVERY_EMPTY_QUEUE_DELAY_SECONDS=30
ONION_CRAWLER_ENABLED=true
ONION_ALWAYS_ON=true
ONION_EXPLORATION_MODE=true
ONION_EMPTY_QUEUE_DELAY_SECONDS=30
ONION_MAINTENANCE_INTERVAL_SECONDS=900
ONION_MAINTENANCE_LEASE_SECONDS=3600
ONION_MAX_PAGE_BYTES=1000000
ONION_REQUEST_TIMEOUT_SECONDS=30
ONION_CONNECT_TIMEOUT_SECONDS=15
ONION_READ_TIMEOUT_SECONDS=30
ONION_TOTAL_FETCH_TIMEOUT_SECONDS=60
ONION_CRAWL_DELAY_SECONDS=10
ONION_VERIFY_DELAY_SECONDS=10
ONION_CARD_DELAY_SECONDS=10
ONION_PREVIEW_DELAY_SECONDS=10
ONION_MAX_DEPTH=3
ONION_INTERNAL_MAX_DEPTH=8
ONION_MAX_PATH_SEGMENTS=12
ONION_MAX_REPEATED_PATH_SEGMENT=3
ONION_MAX_QUERY_PARAMS=8
ONION_MAX_QUERY_VARIANTS_PER_FAMILY=20
ONION_MAX_PAGES_PER_HOST=2000
ONION_MAX_LINKS_PER_PAGE=2000
ONION_MAX_EXTRACTED_LINKS=2000
ONION_MARKETPLACE_MAX_PUBLIC_LINKS_PER_PAGE=75
ONION_MAX_CLASSIFICATION_TEXT_CHARS=200000
ONION_CARD_ENRICHMENT_MAX_URLS=5
ONION_CLAIM_TIMEOUT_MINUTES=45
ONION_DEFER_PAGINATION_AT=10
ONION_HARD_DEFER_PAGINATION_AT=50
ONION_TRAP_BLOCK_SCORE=7
ONION_ADULT_DOMINANCE_THRESHOLD=0.60
# Heartbeat/update batch size while processing link-heavy pages; it is not a total-page cutoff.
ONION_MAX_NEW_LINKS_PER_PAGE=50
# Forums begin with 25 public threads. Each independently relevant thread unlocks
# one additional bounded batch, up to the per-forum ceiling.
ONION_FORUM_INITIAL_THREAD_LIMIT=25
ONION_FORUM_TRIGGER_EXPANSION_BATCH=25
ONION_FORUM_MAX_THREAD_BUDGET=100
ONION_USER_AGENT=Mozilla/5.0 PassiveOSINTResearchBot/1.0

ONION_RELEVANCE_THRESHOLD=5
ONION_HIGH_RISK_THRESHOLD=15

ENABLE_PAGE_SCREENSHOTS=false
PREVIEW_REQUIRE_OCR=false
PREVIEW_RECONCILE_INTERVAL_SECONDS=900
DASHBOARD_PERF_LOG=false
SCREENSHOT_TIMEOUT_SECONDS=20
SCREENSHOT_RATE_WINDOW_SECONDS=3600
SCREENSHOT_WIDTH=1280
SCREENSHOT_HEIGHT=900
SCREENSHOT_MAX_PER_RUN=5
SITE_CARD_LOCK_RETRY_SECONDS=30

# One-time namespace migration only. Leave blank for normal installs. The
# deployment guide explains how to supply the exact prior identifiers safely.
ARACHNE_PREVIOUS_SERVICE_PREFIX=
ARACHNE_PREVIOUS_DB_FILE=
ARACHNE_PREVIOUS_BACKUP_PREFIX=
