{
  "description": "Deterministic local alias-quality rules. These rules reject or route candidates for review; they never merge identities.",
  "rules": [
    {
      "action": "reject",
      "id": "generic-roles",
      "match": "exact",
      "patterns": [
        "admin",
        "administrator",
        "author",
        "buyer",
        "customer",
        "guest",
        "member",
        "moderator",
        "operator",
        "owner",
        "root",
        "seller",
        "staff",
        "support",
        "user",
        "vendor"
      ],
      "reason_code": "rejected_generic_role"
    },
    {
      "action": "reject",
      "id": "navigation-template-labels",
      "match": "exact",
      "patterns": [
        "about",
        "account",
        "blog",
        "category",
        "checkout",
        "contact",
        "directory",
        "footer",
        "forum",
        "header",
        "help",
        "home",
        "index",
        "login",
        "menu",
        "mirror",
        "mirrors",
        "navigation",
        "page",
        "pagination",
        "privacy",
        "product",
        "products",
        "profile",
        "register",
        "rules",
        "search",
        "service",
        "services",
        "shop",
        "store",
        "terms"
      ],
      "reason_code": "rejected_navigation_template"
    },
    {
      "action": "reject",
      "id": "email-provider-labels",
      "match": "exact",
      "patterns": [
        "gmail",
        "googlemail",
        "hotmail",
        "icloud",
        "mail2tor",
        "outlook",
        "proton",
        "protonmail",
        "tutanota",
        "yahoo",
        "yandex"
      ],
      "reason_code": "rejected_provider_word"
    },
    {
      "action": "reject",
      "id": "filename-suffixes",
      "match": "suffix",
      "patterns": [
        ".7z",
        ".bak",
        ".csv",
        ".css",
        ".gif",
        ".htm",
        ".html",
        ".jpg",
        ".js",
        ".json",
        ".log",
        ".onion",
        ".pdf",
        ".php",
        ".png",
        ".rar",
        ".sql",
        ".svg",
        ".tar",
        ".txt",
        ".webp",
        ".xml",
        ".zip"
      ],
      "reason_code": "rejected_filename_like"
    },
    {
      "action": "review",
      "id": "generated-label-prefixes",
      "match": "prefix",
      "patterns": [
        "account_",
        "guest_",
        "member_",
        "seller_",
        "user_",
        "vendor_"
      ],
      "reason_code": "review_generated_prefix"
    }
  ],
  "ruleset_version": "2026-07-16.1",
  "schema_version": 1
}
